

VALID=0
while [ $VALID -eq 0 ]
do
    read -p "Please enter your name and age: " NAME AGE
    if [ -z "$NAME" ] || [ -z "$AGE" ]; then
        echo "You must enter your name and age. Please enter both parameters."
        continue
    elif [[ ! "$NAME" =~ ^[a-zA-Z]+$ ]]; then
        echo "Non-alphabetic characters detected in name: [$NAME]"
        continue
    elif [[ ! "$AGE" =~ ^[0-9]+$ ]]; then
        echo "Non-numeric characters detected in age: [$AGE]"
        continue
    fi
    VALID=1
done
echo "Name = $NAME, Age = $AGE"